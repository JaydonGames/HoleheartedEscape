#version 430
layout(quads, equal_spacing) in;

patch in vec2 wh;
patch in uint flags_in;
flat out uint flags;
out vec2 test_quad_vert;
out vec2 test_vert;
out vec2 tess_vert;

layout(std140) uniform camera_block {
    ivec2 camera;
    float zoom;
};

layout(std140) uniform canvas_block {
    uvec2 canvas;
};

layout(std140) uniform light_block {
    ivec2 pos;
    uint radius;
    float intensity, decay_rate;
    vec3 color;
} light;

vec2 world_to_screen(vec2 pos) {
    pos += (canvas * zoom) / 2 - camera * zoom;
    pos *= 2.0 / (canvas * zoom);
    pos -= 1;
    pos.y *= -1;
    return pos;
}

void main() {
    vec2 vert = gl_TessCoord.xy;
    tess_vert = vert;
    vec2 quad_pos = gl_in[0].gl_Position.xy;
    vec2 quad_center = quad_pos + wh / 2;
    bvec2 quad_vert = bvec2(light.pos.x > quad_center.x, light.pos.y > quad_center.y);
    test_quad_vert = vec2(quad_vert);

    if (vert.x == 0 && abs(quad_center.y - light.pos.y) >= wh.y / 2)
        quad_vert.x = !quad_vert.x;
    else if (vert.x == 1 && abs(quad_center.x - light.pos.x) >= wh.x / 2)
        quad_vert.y = !quad_vert.y;

    test_vert = vec2(quad_vert);
    vec2 pos = world_to_screen(quad_pos + vec2(quad_vert) * wh);
    vec2 light_pos = world_to_screen(light.pos);

    gl_Position = vec4(vert.y != 1 ? pos : (normalize(pos - light_pos) * 12 + light_pos), 0, 1);
    flags = flags_in;
}
